# --- Models (CPU-friendly defaults) -------------------------------------------
# Whisper model size: tiny | base | small | medium | large-v3
# `base` is the sweet spot on Xeon CPU; bump to `small` for better quality.
WHISPER_MODEL=base
# faster-whisper compute type: int8 | int8_float32 | float32
WHISPER_COMPUTE_TYPE=int8

# Translation backend: nllb (self-contained seq2seq) | llm (OpenAI-compatible chat
# server; the GPU default — docker-compose.gpu.yml points it at vLLM on the host)
TRANSLATE_BACKEND=nllb
NLLB_MODEL=facebook/nllb-200-distilled-600M
# LLM_BASE_URL=http://localhost:2080/v1
# LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# LLM_API_KEY_FILE=/path/to/token   # optional bearer token, read from a file

# --- Limits -------------------------------------------------------------------
MAX_VIDEO_DURATION_SECONDS=60
MAX_VIDEO_SIZE_MB=100
MAX_CONCURRENT_JOBS=1

# --- Paths --------------------------------------------------------------------
MODEL_CACHE_DIR=./models
JOB_ARTIFACTS_DIR=./jobs

# --- Server -------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
# Host-side port for the backend. Inside the container uvicorn always listens
# on 8000; this only changes the `host:container` port mapping. 8000 is often
# taken by other local apps, so default to 8088.
BACKEND_PORT=8088
# Host-side port for the Next.js frontend. Inside the container Next.js always
# listens on 3000; this only changes the `host:container` port mapping.
FRONTEND_PORT=3030
CORS_ORIGINS=http://localhost:3030

# --- Lipsync (Stage 5) --------------------------------------------------------
# Backend: none | wav2lip | musetalk | latentsync
# - none: skip lipsync. Mux dubs new audio over the original video.
# - wav2lip: ~30-60s per 3s clip on a 16-core Xeon. CC-BY-NC 4.0 weights.
# - musetalk / latentsync: active services. See docs/gpu/local-updates.md.
LIPSYNC_BACKEND=none
WAV2LIP_CHECKPOINT_URL=https://github.com/justinjohn0306/Wav2Lip/releases/download/models/wav2lip_gan.pth

# MuseTalk runs in its own Compose service (lipsync-musetalk). Host port is
# configurable so it doesn't clash with the backend/frontend on multi-project
# machines. Backend reaches the service via Docker DNS, not this port.
MUSETALK_PORT=8089

# LatentSync also runs in its own Compose service. Host port default 8090.
LATENTSYNC_PORT=8090

# --- LatentSync per-request defaults ------------------------------------------
# Seed the default per-request knobs. Callers can still override per-request.
#
# Denoising steps. LatentSync recommends 20; below 10 quality drops fast.
# LATENTSYNC_STEPS=20
#
# Classifier-free guidance scale. At 1.0 CFG is disabled (CFG kicks in when
# guidance_scale > 1.0). Default 1.5 gives a mild audio-conditioning push;
# 2.0–3.0 pushes harder at the cost of some identity drift. Raise this if
# the output mouth looks translucent or mushy.
# LATENTSYNC_GUIDANCE=1.5

# --- LatentSync performance knobs (opt-out, both default-on) ------------------
# IPEX compute dtype. bf16 enables torch.autocast around the UNet forward —
# 2–4x faster than fp32 on AMX-capable Xeon (Sapphire Rapids+). Set to fp32
# if you're chasing an output-quality issue and want to rule out bf16 drift.
# LATENTSYNC_IPEX_DTYPE=bf16

# DeepCache — caches early denoising-step tensors and reuses them later.
# ~1.3x on top of IPEX. Set to 0 to disable if you suspect it's producing
# artifacts (it usually isn't at cache_interval=3, the upstream default).
# LATENTSYNC_ENABLE_DEEPCACHE=1

# Dry-run mode — collapses num_inference_steps to 1 for fast wiring smoke
# tests. Output is unusable (rainbow noise in the mask region) but the
# whole pipeline runs end-to-end in minutes instead of hours. Use this to
# verify an environment change before committing to a full run.
# LATENTSYNC_DRY_RUN=0

# Debug-dump mode — save intermediate images from face detection, affine
# warp, and the restore_img step into LATENTSYNC_DEBUG_DIR
# (default /jobs/latentsync_debug/). Use this to diagnose quality
# problems: if the output looks wrong, enable and check which stage
# first produces something that looks wrong. Rate-limited to
# LATENTSYNC_DEBUG_FRAME_LIMIT frames per stage (default 3).
# LATENTSYNC_DEBUG_DUMP=0
# LATENTSYNC_DEBUG_FRAME_LIMIT=3

# Temporal smoothing window for per-frame affine matrices + bboxes.
# Decomposes each affine into its 4 similarity-transform parameters
# (translation x, y, rotation, scale) and smooths each independently
# with a centered moving average over this many frames. Eliminates
# translation drift, small rotations, and zoom in/out that landmark
# noise would otherwise produce in the output. Default 9 (0.36 s at
# 25 fps). Set to 1 to disable; larger values smooth more but lag
# real head motion — a 15-frame window with a quick turn trails
# ~7 frames.
# LATENTSYNC_AFFINE_SMOOTH_WINDOW=9

# --- Pre-stabilization (Stage 1.5) --------------------------------------------
# Optional pass that runs ffmpeg's vidstab (or deshake fallback) on the
# source video before transcribe/lipsync/mux. Removes handheld camera
# shake; the main quality win is stabilizing face-track jitter that
# otherwise propagates through landmark → affine → warp-back in the
# lipsync stage. Off by default — most source videos don't need it, and
# it adds ~2× source duration to wall-clock time.
#
# Best for: handheld phone selfies with a mostly-stationary subject.
# Can produce visible artifacts on dramatic subject motion (subtle
# warping, floaty head turns). See backend/app/pipeline/stabilize.py.
# ENABLE_VIDEO_STABILIZATION=false

# Smoothing window for vidstab (value*2+1 frames of centered motion
# averaging). 10 = balanced default. Higher = locked-tripod feel at
# the cost of lag on real motion. Lower = barely smoother than raw.
# STABILIZE_SMOOTHING=10

# Detection sensitivity for vidstab (1-10). Higher catches more shake
# but risks false positives. 5 is upstream's default, good for phones.
# STABILIZE_SHAKINESS=5

# Post-stabilization — stabilize the lipsynced output before mux.
# Independent of ENABLE_VIDEO_STABILIZATION (pre-stab). When the
# pipeline itself introduces jitter that pre-stab can't fix (affine
# residual, VAE precision drift, etc.), this is the catch-all:
# stabilize the final face-replaced video directly regardless of
# where the jitter came from. Same tuning as pre-stab
# (STABILIZE_SMOOTHING / STABILIZE_SHAKINESS). Off by default.
# ENABLE_OUTPUT_STABILIZATION=false

# --- Feature flags ------------------------------------------------------------
# Watermark MUST remain true unless you are doing internal testing. See docs/ethics.md.
ENABLE_WATERMARK=true
ENABLE_C2PA=false
WATERMARK_TEXT=AI-translated

# --- CPU tuning ---------------------------------------------------------------
# Number of CPU threads for inference. Leave these UNSET (commented out) to
# let each library pick its own default — libgomp rejects an empty string and
# prints a scary-looking warning. Uncomment and set to your physical core
# count if you want to pin it.
# OMP_NUM_THREADS=8
# MKL_NUM_THREADS=8

# MuseTalk service IPEX compute dtype. fp32 is safe; bf16 is opt-in and
# ~1.5-2x faster on Sapphire Rapids / Emerald Rapids via AMX. Possible
# subtle quality drift at bf16 — try it and compare outputs.
# MUSETALK_IPEX_DTYPE=fp32

# MuseTalk blend mode. Controls what part of the predicted face is actually
# composited back into the frame.
#   raw    — full lower face (original v1.0 behavior; replaces everything)
#   jaw    — chin + cheeks + mouth (default; chin tracks lips = correct anatomy)
#   mouth  — lips + teeth only (tightest; preserves stubble but causes
#            "sticker" effect because chin stays frozen while lips move)
#   neck   — extends into the neck (rare; usually not what you want)
# MUSETALK_BLEND_MODE=jaw

# Gaussian feather kernel as a fraction of the face-crop width. Larger =
# softer seam (but ghosts small masks). The service caps the absolute
# kernel at 31 px, so values above ~0.08 have no extra effect on big
# crops — the ratio is mostly useful for tightening the feather below
# the default.
# MUSETALK_BLEND_FEATHER=0.04

# Face restoration — runs CodeFormer on each output frame to recover
# high-frequency skin detail (pores, stubble) that the MuseTalk VAE
# smoothed out. Adds ~3-8s per frame on CPU. Set to "none" to skip.
# MUSETALK_FACE_RESTORE=codeformer

# Identity-vs-quality slider for CodeFormer. 0.0 = maximum visual fidelity
# (can morph identity), 1.0 = maximum identity preservation (less detail
# recovery). 0.7 is the commonly recommended balance.
# MUSETALK_FACE_RESTORE_FIDELITY=0.7

# How strongly the restored face blends into the MuseTalk output. Lower
# values preserve more of MuseTalk's original output (useful if CodeFormer
# drifts the identity too far). 0.6 is a safe default.
# MUSETALK_FACE_RESTORE_BLEND=0.6

# --- HuggingFace Hub ----------------------------------------------------------
# Token for HF Hub. Two reasons to set it:
#   1. Higher download rate limits (HF prompts for this on first download).
#   2. REQUIRED for gated repos. The IndicF5 TTS backend
#      (ai4bharat/IndicF5) is gated — set the token AND request access at
#      https://huggingface.co/ai4bharat/IndicF5 before using
#      `tts_backend=indicf5` or `tts_backend=auto` for Indic targets.
# Create a read-only token at https://huggingface.co/settings/tokens.
# Leave commented out to keep using anonymous access (works for all
# non-gated models).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Frontend -----------------------------------------------------------------
# Used by `npm run dev` (outside Docker). In Docker, docker-compose.yml derives
# this from BACKEND_PORT automatically — keep these in sync if you override.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_INGEST_BASE_URL=/ingest

# --- CLI workflow (used by Makefile + scripts) --------------------------------
# These let you run `make run` or `make fetch` without repeating CLI flags.
# Override per-invocation with `make run FIXTURE=... TARGET=ja`.
#
# FIXTURE   — path to the source video. Put clips under artifacts/inputs/.
# TARGET    — target language (BCP-47: es, fr, de, ja, zh, hi, pt, it, ko, ...)
# LIPSYNC   — none | wav2lip | musetalk | latentsync
# OUT_ROOT  — where fetch.sh writes downloaded job artifacts.
# FIXTURE=artifacts/inputs/IMG_7228.MOV
# TARGET=es
# LIPSYNC=none
# OUT_ROOT=./artifacts/jobs

# --- Three-mode GPU setup ------------------------------------------------------
# Run python3 scripts/setup_local.py to create a proxy secret (never public).
# INTERNAL_API_KEY=
# ICE_SERVERS_JSON='[{"urls":["stun:stun.example.com:3478"]},{"urls":["turn:turn.example.com:3478"],"username":"demo","credential":"change-me"}]'
# MAX_PENDING_JOBS=32
# GPU overlay defaults to 120 seconds; full-clip lipsync still has memory limits.
# MAX_VIDEO_DURATION_SECONDS=120
# QUALITY_TRANSLATE_BACKEND=nllb
# QUALITY_TRANSLATE_BACKEND=llm  # contextual translation via LLM_BASE_URL (GPU default)
# TTS_SEGMENT_RETRIES=1
# TTS_MAX_SPEED=1.15
# MUSETALK_DTYPE=fp32  # evaluate fp16 before adopting it
# LATENTSYNC_REALTIME_FACTOR=5.0  # conservative historical estimate; calibrate after GPU tests
# LATENTSYNC_SHARD_MODE=process  # isolated workers; validate on target GPUs
# LATENTSYNC_COMPILE=0
# LATENTSYNC_FRAME_BUDGET_MB=8192
# MUSETALK_FRAME_BUDGET_MB=4096
# INGEST_MAX_SESSIONS=4
# AVATAR_MAX_SESSIONS=1
# AVATAR_VAD_RMS=450
# AVATAR_SPEAKER=  # optional bundled XTTS speaker name
# An LLM server (LLM_BASE_URL) is needed for avatar replies, including when
# translation uses NLLB.
# Dedicated avatar GPUs: add docker-compose.avatar.yml. Defaults are GPUs 5 and 6.
# AVATAR_BACKEND_GPU=5
# AVATAR_MUSETALK_GPU=6
# Remote browser: configure DNS and enable --profile web with these values.
# PUBLIC_HOST=video.example.com
# DEMO_USER=demo
# DEMO_PASSWORD_HASH='$2a$...'  # caddy hash-password; keep single quotes

# --- Local reliability, studio and optional quality features ------------------
# Empty accounts retain single-user local mode. Set long random tokens for users.
# AUTH_TOKENS_JSON='{"replace-with-random-token":"alice"}'
# MAX_USER_JOBS=8
# MAX_USER_STORAGE_MB=10240
# MIN_FREE_DISK_MB=256
# RETENTION_DAYS=0  # disabled; positive values delete expired terminal jobs
# RELEASE_ID=local-unreleased
# MODEL_MANIFEST_SHA256=unverified
# WINDOWED_LIPSYNC=false  # force windows for small clips; oversized clips always use windows
# WINDOW_SECONDS=8
# WINDOW_OVERLAP_SECONDS=0.4
# REWRITE_OVERRUNS=false  # needs LLM_BASE_URL; GPU compose defaults to true. Review rewrites.
# TTS_FIT_RETRIES=2
# ENABLE_ALIGNMENT=false
# ENABLE_DIARIZATION=false
# ENABLE_BACKGROUND_AUDIO=false
# BACKGROUND_GAIN=0.35
# AUDIO_QUALITY_URL=http://audio-quality:8000
# AUDIO_QUALITY_GPU=7  # must not overlap LATENTSYNC_GPUS
# Enable optional service with --profile quality-audio.
# Trained CPU VAD: run scripts/fetch_vad.py into the shared /models volume first.
# AVATAR_VAD_BACKEND=silero
# AVATAR_VAD_THRESHOLD=0.5
# AVATAR_ENDPOINT_SECONDS=0.6
# AVATAR_LIVE_CAPTIONS=false
# AVATAR_RENDER_TIMEOUT=5
# AVATAR_MAX_STORAGE_MB=256
# TURN_URLS_JSON='["turn:turn.example.com:3478"]'
# TURN_SHARED_SECRET=  # coturn static-auth-secret; credentials expire in 10 minutes

# Eight-GPU rollout: generate a separate env overlay using scripts/gpu_layout.py.
# GPU failures do not fall back to CPU. CPU mode uses docker-compose.yml alone.
# WEBRTC_GPU_CODECS=1      # NVENC/NVDEC; H.264 browser support required
# INGEST_GPU=6            # codec engine shares AVATAR_MUSETALK_GPU by default
# AVATAR_GPU_COMPOSITE=1  # tensor blending; compare against 0 on GPU fixtures
# GPU_PROFILE=0          # opt-in CUDA event timings synchronize the current stream
# LLM_MAX_CONCURRENT=2   # per backend process; also limit vLLM server admission
# LLM_MAX_PENDING=8
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_MAX_INPUT_CHARS=96000

# LATENTSYNC_GPUS=2,3,4,5,6,7,1,0  # translation mode: one pool, a worker per GPU; first entry hosts the coordinator
# LLM_GPU_MEMORY_UTILIZATION=0.70  # leaves ~29 GB on the LLM card for a lipsync worker
# GPU LLM overlay: add docker-compose.llm.yml; preserve unrelated servers.
# LLM_BASE_URL=http://llm-gpu:8000/v1
# LLM_GPU=1
# LLM_GPU_PORT=2081  # loopback only
# Dedicated avatar overlay executes inference before opening sessions. Put a
# short English PCM16 mono speech sample and a valid portrait in /models.
# AVATAR_WARMUP_AUDIO_PATH=/models/avatar-warmup/speech.wav
# AVATAR_WARMUP_IMAGE_PATH=/models/avatar-warmup/portrait.png
# The audio must be <=10 seconds for the renderer warm-up. Missing fixtures
# keep dedicated avatar admission closed with a retryable 503.
# GPU_CUDNN_BENCHMARK=0
# ORT_CUDNN_CONV_ALGO_SEARCH=HEURISTIC
# MUSETALK_DETECTION_CACHE=0  # disable for uncached detector benchmarks
