# MuseTalk lipsync microservice — CUDA image (GPU track, docs/gpu/README.md).
#
# Differences from the CPU Dockerfile: CUDA base, torch cu128 (Blackwell
# needs >= 2.7), `.[gpu]` extra (onnxruntime-gpu) instead of `.[cpu]`
# (onnxruntime + IPEX), and no tcmalloc / Intel OpenMP preloads — those
# were CPU allocator tuning.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04 AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-dev \
      ffmpeg \
      ca-certificates \
      git \
      build-essential \
      libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu's system pip is Debian-managed and refuses to upgrade itself, so
# everything goes into a venv that owns its own pip.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY constraints-gpu.txt /app/constraints-gpu.txt
ENV PIP_CONSTRAINT=/app/constraints-gpu.txt

RUN pip install --upgrade pip wheel \
    && pip install "setuptools>=68,<81" \
    && pip install \
       --index-url https://download.pytorch.org/whl/cu128 \
       "torch==2.8.0" \
       "torchaudio==2.8.0" \
       "torchvision==0.23.0" \
    && pip install "torchcodec==0.7.0"

COPY pyproject.toml ./
RUN pip install -e ".[gpu]"

COPY --from=gpu_shared / /opt/gpu-shared
RUN pip install --no-deps /opt/gpu-shared

COPY app ./app
COPY scripts ./scripts

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
